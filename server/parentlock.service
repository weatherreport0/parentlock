[Unit]
Description=Parent control site (Защита)
After=network.target

[Service]
User=parentlock
Group=parentlock
Environment=PARENTLOCK_DB=/var/lib/parentlock/db.sqlite
Environment=PARENTLOCK_PORT=8765
ExecStart=/usr/bin/python3 /opt/parentlock/parentlock_server.py serve
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/parentlock

[Install]
WantedBy=multi-user.target
