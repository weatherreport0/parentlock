# Copy to deploy.env and fill in. deploy.env is git-ignored.
# SSH login of your server (Ubuntu 22.04/24.04 with nginx).
PARENTLOCK_HOST=root@203.0.113.10
# Domain that points to the server. No domain? Use the free <ip-with-dashes>.sslip.io,
# e.g. 203-0-113-10.sslip.io for 203.0.113.10.
PARENTLOCK_DOMAIN=203-0-113-10.sslip.io
# Private SSH key for that login.
PARENTLOCK_SSH_KEY=~/.ssh/id_ed25519
